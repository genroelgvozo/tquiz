# Домен, для которого Caddy выпустит HTTPS-сертификат.
# Без домена: DOMAIN=:80 и PUBLIC_URL=http://<IP сервера>
DOMAIN=quiz.example.ru

# Внешний адрес сайта — он зашивается в QR-код для команд
PUBLIC_URL=https://quiz.example.ru

# Пароль ведущего для /admin
ADMIN_PASSWORD=

# Секрет для подписи cookie и ключа экрана: openssl rand -hex 32
SECRET_KEY=

# Необязательно: другие порты на хосте (если 80/443 заняты)
# HTTP_PORT=80
# HTTPS_PORT=443
